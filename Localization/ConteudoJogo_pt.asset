      m_Items: []
  - m_Id: 753084299493376
    m_Localized: "Derrote o Basilisco que est\xE1 dormindo"
    m_Metadata:
      m_Items: []
  - m_Id: 753198111932416
    m_Localized: Encontre um modo de atrair o basilisco para fora sem irrita-lo
