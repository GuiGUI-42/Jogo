    m_Metadata:
      m_Items: []
  - m_Id: 31470395400192
    m_Localized: "Protesto de G\xE1rgulas"
    m_Metadata:
      m_Items: []
  - m_Id: 31555896287232
    m_Localized: "G\xE1rgulas de pedra entraram em greve e est\xE3o bloqueando a
      entrada do banco exigindo limpeza contra pombos."
    m_Metadata:
      m_Items: []
  - m_Id: 31711890841600
    m_Localized: "Conven\xE7a as g\xE1rgulas para liberarem a entrada do banco"
    m_Metadata:
      m_Items: []
  - m_Id: 31885304340480
    m_Localized: "Limpe as g\xE1rgulas rapidamente para liberar o banco"
    m_Metadata:
      m_Items: []
  - m_Id: 31988610048000
    m_Localized: Slimes no Esgoto
    m_Metadata:
      m_Items: []
  - m_Id: 32077504126976
    m_Localized: "Slimes est\xE3o surgindo das tampas de esgoto."
    m_Metadata:
      m_Items: []
  - m_Id: 32215379288064
    m_Localized: Derrote os Slimes
    m_Metadata:
      m_Items: []
  - m_Id: 32423181885440
    m_Localized: Sniper Elfo
    m_Metadata:
      m_Items: []
  - m_Id: 32491364491264
    m_Localized: "Um elfo arqueiro est\xE1 no topo de um pr\xE9dio atirando em antenas
      de 5G (ele acha que interferem na magia)."
    m_Metadata:
      m_Items: []
  - m_Id: 32613108359168
    m_Localized: Derrote o Elfo Sniper
    m_Metadata:
      m_Items: []
  - m_Id: 32798999912448
    m_Localized: "Promo\xE7\xE3o Maldita"
    m_Metadata:
      m_Items: []
  - m_Id: 32887382286336
    m_Localized: "Uma loja oferece 99% de desconto, mas o custo \xE9 a sua alma.
      - Diabo"
    m_Metadata:
      m_Items: []
  - m_Id: 33012104110080
    m_Localized: Derrote o Diabo comprador de alma
    m_Metadata:
      m_Items: []
  - m_Id: 33282863210496
    m_Localized: "Compre itens- com sua reputa\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 33696731963392
    m_Localized: "Pra\xE7a de Alimenta\xE7\xE3o"
    m_Metadata:
      m_Items: []
