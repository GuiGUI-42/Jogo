    m_Metadata:
      m_Items: []
  - m_Id: 48645696987136
    m_Localized: "Derrote os ca\xE7adores de un\xEDcornios"
    m_Metadata:
      m_Items: []
  - m_Id: 48802165497856
    m_Localized: O eremita Ex-Aventureiro
    m_Metadata:
      m_Items: []
  - m_Id: 48906184237056
    m_Localized: "Um mago velho e louco est\xE1 soltando bolas de fogo em quem pisa
