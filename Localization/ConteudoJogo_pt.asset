      m_Items: []
  - m_Id: 47554393612288
    m_Localized: Derrote os garimpeiros
    m_Metadata:
      m_Items: []
  - m_Id: 47665433616384
    m_Localized: Druidas vs. Madeireira
    m_Metadata:
      m_Items: []
  - m_Id: 47720727126016
    m_Localized: "Ativistas druidas est\xE3o transformando tratores em \xE1rvores
