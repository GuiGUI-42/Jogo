    m_Metadata:
      m_Items: []
  - m_Id: 48300652568576
    m_Localized: Derrote a Dryad antes que o sinal caia
    m_Metadata:
      m_Items: []
  - m_Id: 48397931061248
    m_Localized: "Ca\xE7a Ilegal de Unic\xF3rnios"
    m_Metadata:
      m_Items: []
  - m_Id: 48475043340288
    m_Localized: "Ca\xE7adores modernos com rifles est\xE3o atr\xE1s de criaturas
