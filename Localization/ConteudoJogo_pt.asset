    m_Metadata:
      m_Items: []
  - m_Id: 34670343168000
    m_Localized: Encontre a fonte do Azar e ache o item
    m_Metadata:
      m_Items: []
  - m_Id: 34855970480128
    m_Localized: Furtos de Gnomos
    m_Metadata:
      m_Items: []
  - m_Id: 34913105289216
    m_Localized: "Gnomos invis\xEDveis est\xE3o roubando celulares dos bolsos das
      pessoas."
    m_Metadata:
      m_Items: []
  - m_Id: 35071113109504
    m_Localized: Derrote os Gnomos
    m_Metadata:
      m_Items: []
  - m_Id: 35521287757824
    m_Localized: O Curandeiro
    m_Metadata:
      m_Items: []
  - m_Id: 35601285718016
    m_Localized: "O m\xE9dico da comunidade precisa de ervas raras para curar uma
      doen\xE7a m\xE1gica."
    m_Metadata:
      m_Items: []
  - m_Id: 35707019927552
    m_Localized: "Encontre os ingredientes o mais r\xE1pido poss\xEDvel"
    m_Metadata:
      m_Items: []
  - m_Id: 35911198646272
    m_Localized: "Encontre os ingredientes com maior n\xEDvel de qualidade"
    m_Metadata:
      m_Items: []
  - m_Id: 36013703241728
    m_Localized: Laje Asssombrada
    m_Metadata:
      m_Items: []
  - m_Id: 36096318447616
    m_Localized: "Um fantasma n\xE3o deixa ningu\xE9m soltar pipa na laje mais alta."
    m_Metadata:
      m_Items: []
  - m_Id: 36215608647680
    m_Localized: ' Derrote o Fanstasma'
    m_Metadata:
      m_Items: []
  - m_Id: 36332440985600
    m_Localized: Batalha de Rap
    m_Metadata:
      m_Items: []
  - m_Id: 36398878760960
    m_Localized: "Um Bardo est\xE1 usando magia de controle mental durante uma batalha
      de rimas."
    m_Metadata:
      m_Items: []
  - m_Id: 36538872045568
    m_Localized: " Derrote o Bardo, mas n\xE3o em uma batalha de rima"
    m_Metadata:
      m_Items: []
  - m_Id: 36688587726848
    m_Localized: "Conven\xE7a o Bardo a parar de trapacear"
    m_Metadata:
      m_Items: []
  - m_Id: 36824751611904
    m_Localized: "Ajudantte do tr\xE1fico"
    m_Metadata:
      m_Items: []
  - m_Id: 36914308390912
