      m_Items: []
  - m_Id: 752860403351552
    m_Localized: "T\xFAnel Interditado"
    m_Metadata:
      m_Items: []
  - m_Id: 752964367564800
    m_Localized: "Um Basilisco est\xE1 dormindo no meio do t\xFAnel que corta a montanha."
