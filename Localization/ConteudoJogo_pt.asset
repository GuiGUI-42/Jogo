      m_Items: []
  - m_Id: 7924633903104
    m_Localized: Portal para o Submundo
    m_Metadata:
      m_Items: []
  - m_Id: 8018347237376
    m_Localized: Um buraco aberto em uma cova leva direto para o inferno.
