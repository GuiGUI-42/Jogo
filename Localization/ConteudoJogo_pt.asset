    m_Metadata:
      m_Items: []
  - m_Id: 370688032317440
    m_Localized: "Um goblin est\xE1 vendendo po\xE7\xF5es de cura vencidas nos vag\xF5es."
    m_Metadata:
      m_Items: []
  - m_Id: 370758429515776
    m_Localized: Derrote o  goblin
    m_Metadata:
      m_Items: []
  - m_Id: 370862448254976
    m_Localized: "Conven\xE7a o Goblin a beber a pr\xF3pria po\xE7\xE3o"
    m_Metadata:
      m_Items: []
  - m_Id: 370988851994624
    m_Localized: ' Atraia o goblin para prender ele no flagra'
    m_Metadata:
      m_Items: []
  - m_Id: 752607189024768
