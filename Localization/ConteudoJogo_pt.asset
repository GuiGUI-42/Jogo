  m_TableData:
  - m_Id: 5696925802496
    m_Localized: "Um fantasma exige ver sua certid\xE3o de \xF3bito para descansar"
    m_Metadata:
      m_Items: []
  - m_Id: 637580156928
    m_Localized: "Esp\xEDrito Burocrata"
    m_Metadata:
      m_Items: []
