    m_Localized: 'Derrote o elemental de gordura '
    m_Metadata:
      m_Items: []
  - m_Id: 34123284291584
    m_Localized: Loja de Penhores
    m_Metadata:
      m_Items: []
  - m_Id: 34204544737280
    m_Localized: "Um item amaldi\xE7oado foi vendido e est\xE1 causando azar em todo
      o shopping."
    m_Metadata:
      m_Items: []
  - m_Id: 34430538031104
