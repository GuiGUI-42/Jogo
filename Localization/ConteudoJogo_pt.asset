    m_Metadata:
      m_Items: []
  - m_Id: 47946384875520
    m_Localized: "Conven\xE7a os druidas a irem embora"
    m_Metadata:
      m_Items: []
  - m_Id: 48106376601600
    m_Localized: A Torre de Celular
    m_Metadata:
      m_Items: []
  - m_Id: 48176706691072
    m_Localized: "Uma Dryad est\xE1 destruindo uma torre de celular camuflada de
